# SPDX-License-Identifier: MIT

if SHIELD_CRADIO_DONGLE

# Max 16 characters. Same name the left half used when it was the central.
config ZMK_KEYBOARD_NAME
    default "Cradio"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left and right halves.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two halves plus the default 5 profile slots. The slots stay so the
# keymap's &bt keys stay in range. The dongle does not advertise them.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
